        //         timeout(time: 5, unit: 'MINUTES') {
        //             // Pauses pipeline and waits for the webhook response from SonarQube
        //             waitForQualityGate abortPipeline: true 
        //         }
        //     }
        // }

        stage('Check Dependabot Alerts') {
    steps {
        withCredentials([string(credentialsId: 'github-token', variable: 'GITHUB_TOKEN')]) {
            script {

                def response = sh(
                    script: '''
                    curl -s -L \
                      -H "Accept: application/vnd.github+json" \
                      -H "Authorization: Bearer $GITHUB_TOKEN" \
                      https://api.github.com/repos/daws-84s/catalogue/dependabot/alerts
                    ''',
                    returnStdout: true
                ).trim()

                echo "GitHub Response: ${response}"

                def json = readJSON text: response

                // Handle API errors
                if (json instanceof Map) {
                    error "GitHub API Error: ${json.message}"
                }

                def vulnerableAlerts = json.findAll { alert ->
                    alert?.state == 'open' &&
                    ['critical', 'high'].contains(
                        alert?.security_advisory?.severity?.toLowerCase()
                    )
                }

                if (vulnerableAlerts.size() > 0) {
                    error "Found ${vulnerableAlerts.size()} HIGH/CRITICAL alerts"
                }

                echo "No HIGH/CRITICAL alerts found"
            }
        }
    }
}
